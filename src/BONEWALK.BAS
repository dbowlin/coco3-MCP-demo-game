10 REM BONEWALK - COCO 3 HSCREEN 16-COLOR
20 REM TANDY: HSCREEN 2 = 320X192 16-COLOR (NOT MODE 3/4)
30 CLEAR 200,&H7F00
40 POKE 282,0
50 DIM M(37,19)
60 R=RND(-TIMER)
70 GOSUB 7000
80 LV=1
90 GOSUB 9000
100 IF LV>5 THEN 8000
110 GOSUB 1000
120 GOSUB 2000
130 GOSUB 3000
140 GOTO 100
1000 REM --- SIZE FOR LEVEL ---
1010 MW=19:MH=9
1020 IF LV=2 THEN MW=23:MH=11
1030 IF LV=3 THEN MW=27:MH=13
1040 IF LV=4 THEN MW=31:MH=15
1050 IF LV=5 THEN MW=35:MH=17
1060 TW=8:TH=8
1070 OX=INT((320-MW*TW)/2)
1080 OY=28+INT((164-MH*TH)/2)
1090 RETURN
2000 REM --- FAST BINARY-TREE MAZE ---
2010 HCLS 0
2020 COLOR 5,0
2030 HPRINT (12,11),"CARVING CIRCUIT"
2040 HPRINT (18,13),STR$(LV)
2050 FOR Y=1 TO MH
2060 FOR X=1 TO MW:M(X,Y)=0:NEXT X
2070 NEXT Y
2080 FOR Y=1 TO MH STEP 2
2090 FOR X=1 TO MW STEP 2
2100 M(X,Y)=1
2110 EE=0:SS=0
2120 IF X+2<=MW THEN EE=1
2130 IF Y+2<=MH THEN SS=1
2140 IF EE=0 AND SS=0 THEN 2210
2150 IF EE=1 AND SS=0 THEN 2180
2160 IF EE=0 AND SS=1 THEN 2200
2170 IF RND(2)=1 THEN 2180 ELSE 2200
2180 M(X+1,Y)=1:M(X+2,Y)=1:GOTO 2210
2200 M(X,Y+1)=1:M(X,Y+2)=1
2210 NEXT X
2220 NEXT Y
2230 EX=MW:EY=MH
2240 PX=1:PY=1
2250 IF MW>=3 THEN M(2,1)=1:M(3,1)=1
2260 RETURN
3000 REM --- PLAY LEVEL ---
3010 HCLS 0
3020 GOSUB 5000
3030 COLOR 5,0
3040 HPRINT (1,0),"BONEWALK"
3050 COLOR 2,0
3060 HPRINT (15,0),"CIRCUIT"
3070 HPRINT (23,0),STR$(LV)
3080 HPRINT (26,0),"/ 5"
3090 COLOR 1,0
3100 HPRINT (1,2),"WASD/ARROWS - REACH EXIT"
3110 FOR Y=1 TO MH
3120 FOR X=1 TO MW
3130 SX=OX+(X-1)*TW:SY=OY+(Y-1)*TH
3140 IF M(X,Y)=0 THEN HPUT(SX,SY)-(SX+7,SY+7),2,PSET:GOTO 3160
3150 HPUT(SX,SY)-(SX+7,SY+7),1,PSET
3160 NEXT X
3170 NEXT Y
3180 SX=OX+(EX-1)*TW:SY=OY+(EY-1)*TH
3190 HPUT(SX,SY)-(SX+7,SY+7),4,PSET
3200 SX=OX+(PX-1)*TW:SY=OY+(PY-1)*TH
3210 HPUT(SX,SY)-(SX+7,SY+7),3,PSET
3220 K$=INKEY$:IF K$="" THEN 3220
3230 KC=ASC(K$)
3240 DX=0:DY=0
3250 IF KC=87 OR KC=119 OR KC=94 THEN DY=-1
3260 IF KC=83 OR KC=115 OR KC=10 THEN DY=1
3270 IF KC=65 OR KC=97 OR KC=8 THEN DX=-1
3280 IF KC=68 OR KC=100 OR KC=9 THEN DX=1
3290 IF KC=81 OR KC=113 THEN 8500
3300 IF DX=0 AND DY=0 THEN 3220
3310 TX=PX+DX:TY=PY+DY
3320 IF TX<1 OR TX>MW OR TY<1 OR TY>MH THEN 3220
3330 IF M(TX,TY)=0 THEN 3220
3340 SX=OX+(PX-1)*TW:SY=OY+(PY-1)*TH
3350 IF PX=EX AND PY=EY THEN HPUT(SX,SY)-(SX+7,SY+7),4,PSET:GOTO 3370
3360 HPUT(SX,SY)-(SX+7,SY+7),1,PSET
3370 PX=TX:PY=TY
3380 SX=OX+(PX-1)*TW:SY=OY+(PY-1)*TH
3390 HPUT(SX,SY)-(SX+7,SY+7),3,PSET
3400 IF PX=EX AND PY=EY THEN 4000
3410 GOTO 3220
4000 REM --- LEVEL CLEAR ---
4010 FOR I=1 TO 400:NEXT I
4020 HCLS 0
4030 COLOR 5,0
4040 HPRINT (12,6),"CIRCUIT CLEARED"
4050 HPRINT (18,8),STR$(LV)
4060 COLOR 2,0
4070 IF LV=1 THEN HPRINT (6,11),"THE MACHINE NOTICES YOU."
4080 IF LV=2 THEN HPRINT (5,11),"BONES CLICK ON THE FLOOR."
4090 IF LV=3 THEN HPRINT (10,11),"PATHS GROW TEETH."
4100 IF LV=4 THEN HPRINT (4,11),"SOMETHING BREATHES STATIC."
4110 IF LV=5 THEN HPRINT (7,11),"THE CORE OPENS A CRACK."
4120 COLOR 1,0
4130 HPRINT (12,16),"PRESS ANY KEY"
4140 K$=INKEY$:IF K$="" THEN 4140
4150 LV=LV+1
4160 RETURN
5000 REM --- BUILD TILE BUFFERS (ROM ML HGET/HPUT) ---
5010 IF TB=1 THEN RETURN
5020 HBUFF 1,65:HBUFF 2,65:HBUFF 3,65:HBUFF 4,65
5030 REM PATH TILE (ORANGE CIRCUIT - WALKABLE)
5040 HCLS 0
5050 FOR Y=0 TO 7:FOR X=0 TO 7:HSET(X,Y,2):NEXT X,Y
5060 FOR Y=1 TO 6:FOR X=1 TO 6:HSET(X,Y,10):NEXT X,Y
5070 FOR Y=2 TO 5:FOR X=2 TO 5:HSET(X,Y,2):NEXT X,Y
5080 FOR X=0 TO 7:HSET(X,3,10):NEXT X
5090 FOR Y=0 TO 7:HSET(3,Y,10):NEXT Y
5100 HGET(0,0)-(7,7),1
5110 REM WALL TILE (DARK FILL)
5120 HCLS 0
5130 FOR Y=0 TO 7:FOR X=0 TO 7:HSET(X,Y,0):NEXT X,Y
5140 HSET(1,1,8):HSET(5,3,8):HSET(2,6,8):HSET(6,5,8)
5150 HGET(0,0)-(7,7),2
5160 REM PLAYER STICK FIGURE
5170 HCLS 0
5180 FOR Y=0 TO 7:FOR X=0 TO 7:HSET(X,Y,0):NEXT X,Y
5190 HSET(3,1,5):HSET(4,1,5):HSET(3,2,5):HSET(4,2,5)
5200 HSET(3,3,5):HSET(4,3,5):HSET(3,4,5):HSET(4,4,5):HSET(3,5,5):HSET(4,5,5)
5210 HSET(1,3,5):HSET(2,3,5):HSET(5,3,5):HSET(6,3,5)
5220 HSET(2,6,5):HSET(3,7,5):HSET(4,7,5):HSET(5,6,5)
5230 HGET(0,0)-(7,7),3
5240 REM EXIT GLYPH
5250 HCLS 0
5260 FOR Y=0 TO 7:FOR X=0 TO 7:HSET(X,Y,0):NEXT X,Y
5270 FOR Y=1 TO 6:HSET(1,Y,3):HSET(6,Y,3):NEXT Y
5280 FOR X=1 TO 6:HSET(X,1,3):HSET(X,6,3):NEXT X
5290 FOR Y=2 TO 5:FOR X=2 TO 5:HSET(X,Y,3):NEXT X,Y
5300 FOR Y=0 TO 7:HSET(3,Y,15):HSET(4,Y,15):NEXT Y
5310 HSET(5,3,15):HSET(6,3,15):HSET(7,3,15):HSET(5,4,15):HSET(6,4,15):HSET(7,4,15)
5320 HGET(0,0)-(7,7),4
5330 TB=1
5340 RETURN
7000 REM --- GRAPHICS + PALETTE + ML HOOK (LOADM FASTPUT) ---
7010 LOADM"FASTPUT"
7020 DEF USR0=&H7F00
7030 A=USR0(0)
7040 HSCREEN 2
7050 PALETTE 0,0
7060 PALETTE 1,54
7070 PALETTE 2,36
7080 PALETTE 3,18
7090 PALETTE 4,9
7100 PALETTE 5,63
7110 PALETTE 8,7
7120 PALETTE 10,38
7130 PALETTE 15,63
7140 COLOR 5,0
7150 TB=0
7160 RETURN
8000 REM --- WIN ---
8010 HCLS 0
8020 COLOR 5,0
8030 HPRINT (11,5),"BONEWALK COMPLETE"
8040 COLOR 3,0
8050 HPRINT (5,8),"FIVE CIRCUITS. NO ECHO LEFT."
8060 COLOR 2,0
8070 HPRINT (9,11),"YOU WERE NEVER CODE."
8080 HPRINT (9,13),"YOU WERE THE GLITCH."
8090 COLOR 1,0
8100 HPRINT (8,18),"(R) AGAIN   (Q) QUIT"
8110 K$=INKEY$:IF K$="" THEN 8110
8120 KC=ASC(K$)
8130 IF KC=82 OR KC=114 THEN LV=1:GOTO 100
8140 IF KC=81 OR KC=113 THEN 8500
8150 GOTO 8110
8500 HSCREEN 0:WIDTH 40:ATTR 0,0:CLS:PRINT "BONES REST.":END
9000 REM --- TITLE ---
9010 HCLS 0
9020 GOSUB 5000
9030 FOR I=0 TO 37
9040 HPUT(8+I*8,40)-(15+I*8,47),1,PSET
9050 HPUT(8+I*8,136)-(15+I*8,143),1,PSET
9060 NEXT I
9070 COLOR 5,0
9080 HPRINT (11,8),"B O N E W A L K"
9090 COLOR 2,0
9100 HPRINT (8,11),"A STICK FIGURE LOOSE"
9110 HPRINT (8,13),"INSIDE MACHINE MEMORY."
9120 COLOR 1,0
9130 HPRINT (5,19),"ARROWS/WASD  Q QUITS"
9140 COLOR 3,0
9150 HPRINT (9,21),"PRESS ANY KEY TO WAKE"
9160 SX=152:SY=120
9170 HPUT(SX,SY)-(SX+7,SY+7),3,PSET
9180 K$=INKEY$:IF K$="" THEN 9180
9190 RETURN
