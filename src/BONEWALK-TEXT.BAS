10 REM BONEWALK - COCO 3 MAZE RUNNER
20 WIDTH 40
30 POKE 282,0
40 CLEAR 200
50 DIM M(37,19)
60 R=RND(-TIMER)
70 PALETTE 0,0
80 PALETTE 8,63
90 PALETTE 9,36
100 PALETTE 10,18
110 PALETTE 11,9
120 PALETTE 12,54
130 PALETTE 13,7
140 LV=1
150 GOSUB 9000
160 IF LV>5 THEN 8000
170 GOSUB 1000
180 GOSUB 2000
190 GOSUB 3000
200 GOTO 160
1000 REM --- SIZE FOR LEVEL ---
1010 MW=19:MH=9
1020 IF LV=2 THEN MW=23:MH=11
1030 IF LV=3 THEN MW=27:MH=13
1040 IF LV=4 THEN MW=31:MH=15
1050 IF LV=5 THEN MW=35:MH=17
1060 OX=INT((40-MW)/2)
1070 OY=3+INT((20-MH)/2)
1080 RETURN
2000 REM --- FAST BINARY-TREE MAZE ---
2010 CLS 1
2020 ATTR 5,0
2030 LOCATE 8,10:PRINT "CARVING CIRCUIT";LV;"..."
2040 FOR Y=1 TO MH
2050 FOR X=1 TO MW:M(X,Y)=0:NEXT X
2060 NEXT Y
2070 FOR Y=1 TO MH STEP 2
2080 FOR X=1 TO MW STEP 2
2090 M(X,Y)=1
2100 EE=0:SS=0
2110 IF X+2<=MW THEN EE=1
2120 IF Y+2<=MH THEN SS=1
2130 IF EE=0 AND SS=0 THEN 2200
2140 IF EE=1 AND SS=0 THEN 2170
2150 IF EE=0 AND SS=1 THEN 2190
2160 IF RND(2)=1 THEN 2170 ELSE 2190
2170 M(X+1,Y)=1:M(X+2,Y)=1:GOTO 2200
2190 M(X,Y+1)=1:M(X,Y+2)=1
2200 NEXT X
2210 NEXT Y
2220 EX=MW:EY=MH
2230 PX=1:PY=1
2235 REM ALWAYS OPEN FIRST STEP EAST FOR A CLEAR START
2240 IF MW>=3 THEN M(2,1)=1:M(3,1)=1
2250 RETURN
3000 REM --- PLAY LEVEL ---
3010 CLS 1
3020 ATTR 5,0
3030 LOCATE 0,0:PRINT "BONEWALK";
3040 ATTR 2,0
3050 LOCATE 16,0:PRINT "CIRCUIT";LV;"/5";
3060 ATTR 1,0
3070 LOCATE 0,1:PRINT "WASD/ARROWS MOVE - REACH >";
3080 FOR Y=1 TO MH
3090 FOR X=1 TO MW
3100 IF M(X,Y)=0 THEN ATTR 2,0:LOCATE OX+X-1,OY+Y-1:PRINT "#";:GOTO 3120
3110 ATTR 0,0:LOCATE OX+X-1,OY+Y-1:PRINT " ";
3120 NEXT X
3130 NEXT Y
3140 ATTR 3,0:LOCATE OX+EX-1,OY+EY-1:PRINT ">";
3150 ATTR 5,0:LOCATE OX+PX-1,OY+PY-1:PRINT "@";
3160 K$=INKEY$:IF K$="" THEN 3160
3170 KC=ASC(K$)
3180 DX=0:DY=0
3190 IF KC=87 THEN DY=-1
3200 IF KC=119 THEN DY=-1
3210 IF KC=94 THEN DY=-1
3220 IF KC=83 THEN DY=1
3230 IF KC=115 THEN DY=1
3240 IF KC=10 THEN DY=1
3250 IF KC=65 THEN DX=-1
3260 IF KC=97 THEN DX=-1
3270 IF KC=8 THEN DX=-1
3280 IF KC=68 THEN DX=1
3290 IF KC=100 THEN DX=1
3300 IF KC=9 THEN DX=1
3310 IF KC=81 THEN 8500
3320 IF KC=113 THEN 8500
3330 IF DX=0 AND DY=0 THEN 3160
3340 TX=PX+DX:TY=PY+DY
3350 IF TX<1 OR TX>MW OR TY<1 OR TY>MH THEN 3160
3360 IF M(TX,TY)=0 THEN 3160
3370 ATTR 0,0:LOCATE OX+PX-1,OY+PY-1:PRINT " ";
3380 IF PX=EX AND PY=EY THEN ATTR 3,0:LOCATE OX+PX-1,OY+PY-1:PRINT ">";
3390 PX=TX:PY=TY
3400 ATTR 5,0:LOCATE OX+PX-1,OY+PY-1:PRINT "@";
3410 IF PX=EX AND PY=EY THEN 4000
3420 GOTO 3160
4000 REM --- LEVEL CLEAR ---
4010 FOR I=1 TO 300:NEXT I
4020 CLS 1
4030 ATTR 5,0
4040 LOCATE 8,5:PRINT "CIRCUIT";LV;" CLEARED."
4050 ATTR 2,0
4060 IF LV=1 THEN LOCATE 6,7:PRINT "THE MACHINE NOTICES YOU."
4070 IF LV=2 THEN LOCATE 6,7:PRINT "BONES CLICK ON THE FLOOR."
4080 IF LV=3 THEN LOCATE 10,7:PRINT "PATHS GROW TEETH."
4090 IF LV=4 THEN LOCATE 5,7:PRINT "SOMETHING BREATHES STATIC."
4100 IF LV=5 THEN LOCATE 7,7:PRINT "THE CORE OPENS A CRACK."
4110 ATTR 1,0
4120 LOCATE 12,10:PRINT "PRESS ANY KEY"
4130 K$=INKEY$:IF K$="" THEN 4130
4140 LV=LV+1
4150 RETURN
8000 REM --- WIN ---
8010 CLS 1
8020 ATTR 5,0
8030 LOCATE 10,4:PRINT "BONEWALK COMPLETE"
8040 ATTR 3,0
8050 LOCATE 5,6:PRINT "FIVE CIRCUITS. NO ECHO LEFT."
8060 ATTR 2,0
8070 LOCATE 9,8:PRINT "YOU WERE NEVER CODE."
8080 LOCATE 9,9:PRINT "YOU WERE THE GLITCH."
8090 ATTR 1,0
8100 LOCATE 8,12:PRINT "(R) AGAIN   (Q) QUIT"
8110 K$=INKEY$:IF K$="" THEN 8110
8120 KC=ASC(K$)
8130 IF KC=82 OR KC=114 THEN LV=1:GOTO 160
8140 IF KC=81 OR KC=113 THEN 8500
8150 GOTO 8110
8500 CLS:ATTR 0,0:PRINT "BONES REST.":END
9000 REM --- TITLE ---
9010 CLS 1
9020 ATTR 5,0
9030 LOCATE 12,2:PRINT "B O N E W A L K"
9040 ATTR 2,0
9050 LOCATE 9,4:PRINT "A STICK FIGURE LOOSE"
9060 LOCATE 9,5:PRINT "INSIDE MACHINE MEMORY."
9070 ATTR 1,0
9080 LOCATE 5,7:PRINT "FIVE CIRCUITS. ONE EXIT EACH."
9090 LOCATE 6,8:PRINT "ARROWS OR WASD. Q QUITS."
9100 ATTR 3,0
9110 LOCATE 8,11:PRINT "PRESS ANY KEY TO WAKE"
9120 K$=INKEY$:IF K$="" THEN 9120
9130 RETURN
